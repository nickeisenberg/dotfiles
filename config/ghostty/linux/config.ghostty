palette = 3=#f3be7c
palette = 4=#7e98e8
palette = 5=#bb9dbd
palette = 6=#b4d4cf
palette = 7=#cdcdcd

# Bright colors
palette = 8=#606079
palette = 9=#df6882
palette = 10=#8cb66d
palette = 11=#f3be7c
palette = 12=#7e98e8
palette = 13=#bb9dbd
palette = 14=#b4d4cf
